# U + JARVIS — Environment Configuration
# Creator: Jenny Kluth | Version: 2026.07.29-fixed

# ── Required for signed request verification ───────────────────────
# Shared HMAC secret (min 32 chars). Must match Base44 U_SHARED_SECRET.
U_SHARED_SECRET=
# Set to "true" to enforce signed requests from Base44.
U_REQUIRE_SIGNED_REQUESTS=true

# ── Core system ────────────────────────────────────────────────────
U_ENV=development
U_REASONER=deterministic
U_TOOL_MODE=demo
U_MODEL=gpt-4.1-mini
U_DATABASE_PATH=u.db

# ── Azure (optional, for production LLM + RAG) ──────────────────────
OPENAI_API_KEY=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_COSMOS_ENDPOINT=
AZURE_SEARCH_ENDPOINT=
AZURE_KEY_VAULT_URL=
AZURE_APPLICATIONINSIGHTS_CONNECTION_STRING=
